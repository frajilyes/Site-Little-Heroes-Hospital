# Connexion MySQL locale
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hopital_enfants

# Compte administrateur créé par `npm run db:setup`
# (le code de vérification de connexion est envoyé à ADMIN_EMAIL : mettez une vraie adresse)
ADMIN_EMAIL=admin@petitsheros.fr
ADMIN_PASSWORD=Admin123!

# Secret de signature des sessions admin (chaîne longue et aléatoire)
SESSION_SECRET=change-moi-par-une-longue-chaine-aleatoire

# Envoi des e-mails (codes de confirmation : connexion admin, prise et annulation de RDV)
# Sans SMTP_HOST, en développement, le code s'affiche dans le terminal de `npm run dev`.
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=votre@gmail.com,
#         SMTP_PASSWORD=mot de passe d'application (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Hôpital des Petits Héros <votre@gmail.com>"

# Adresse publique du site (lien « suivre mon rendez-vous » dans l'e-mail récapitulatif)
SITE_URL=http://localhost:3000
